# Raiz do projeto. Redireciona o acesso a /sesjur-processos/ para a pasta public/.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /sesjur-processos/
    # Acesso a raiz do projeto -> public/
    RewriteRule ^$ public/ [L,R=302]
    # Pasta .git (o servidor recebe o projeto por git pull): o historico
    # contem backups do banco com dados reais. Nunca servir.
    RewriteRule (^|/)\.git(/|$) - [F,L]
</IfModule>
<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 403 /\.git(/|$)
    </IfModule>
</IfModule>

# Bloqueia o acesso a arquivos sensiveis em qualquer subpasta.
<FilesMatch "(^\.|\.(sql|md|log|bak|ini)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
