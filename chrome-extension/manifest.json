{
  "manifest_version": 3,
  "name": "Gestão Jurídica — Integração SIGADOC/PJe",
  "version": "1.4.0",
  "description": "Extrai dados de processos do SIGADOC e do PJe a partir do DOM das páginas que o usuário já está autorizado a acessar, e os entrega à aplicação local para revisão humana. Permite criar o processo no SESJUR a partir da página.",
  "minimum_chrome_version": "114",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "action": {
    "default_title": "Gestão Jurídica — Integração",
    "default_popup": "options/options.html"
  },
  "permissions": [
    "contextMenus",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://10.15.22.20/*",
    "http://10.15.120.216/*",
    "http://sesjur.saude.mt.gov.br/*",
    "https://sesjur.saude.mt.gov.br/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://10.15.22.20/*",
        "http://10.15.120.216/*",
        "http://sesjur.saude.mt.gov.br/*",
        "https://sesjur.saude.mt.gov.br/*"
      ],
      "js": [
        "content/app-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}